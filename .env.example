# Copy this file to `.env` before production deploy.

# Required for secure auth/audit/vault operations.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
FLASK_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
AUDIT_HMAC_KEY=replace-with-a-long-random-secret-at-least-32-chars
PII_VAULT_KEY=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@privacyfirewall.local
ADMIN_PASSWORD=admin-pass

# Optional model provider controls.
LLM_DEFAULT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URLS=http://host.docker.internal:11434,http://172.17.0.1:11434,http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
CLIENT_MAX_ATTACHMENTS=6
CLIENT_MAX_ATTACHMENT_BYTES=8388608
CLIENT_MAX_TOTAL_ATTACHMENT_BYTES=25165824
CLIENT_ATTACHMENT_TEXT_CHARS=6000
CLIENT_MAX_IMAGES_TO_MODEL=3

# Optional Google OAuth (requires Authlib/OAuth integration in app config).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_SCOPE=openid email profile
